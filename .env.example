# ReferÃªncia: o programa lÃª variÃ¡veis do processo, nÃ£o carrega este arquivo sozinho.
CENTRAL_PROVIDER=mock
CENTRAL_ALLOW_PAID=false
CENTRAL_DB=central.sqlite3
# micros USD: 1000000 = US$ 1. Zero bloqueia chamadas reais.
CENTRAL_DAILY_MICROUSD=0
CENTRAL_CALL_MICROUSD=0
CENTRAL_RESERVE_MICROUSD=0
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=

# Fase 3 isolada: somente OpenAI. NÃ£o carrega este arquivo automaticamente.
# O comando demo ignora estas opÃ§Ãµes e sempre usa simulaÃ§Ã£o.
P3_MODE=mock
P3_MODEL=gpt-5.4-mini-2026-03-17
P3_ENABLE_OPENAI=false
P3_PRICES_ACK=false
P3_MAX_OUTPUT_TOKENS=256
P3_BUDGET_MICROUSD=0
P3_CALL_MICROUSD=10000
P3_MAX_ATTEMPTS=2
P3_TIMEOUT_SECONDS=10

# Integração explícita OpenAI/Gemini: este arquivo não habilita chamadas.
INTEGRATIONS_ENABLE_REAL=false
INTEGRATIONS_PRICES_ACK=false
# GEMINI_API_KEY já aparece acima. Não duplicar nem preencher este exemplo.
# Modelo padrão revisado da extensão: gemini-3.5-flash-lite.
